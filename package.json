{
  "name": "kranz-tv",
  "version": "2.12.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:node": "NITRO_PRESET=node-server vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "test:e2e": "playwright test",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@datadog/browser-logs": "6.33.0",
    "@datadog/browser-rum": "6.33.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "dd-trace": "5.106.0",
    "lucide-react": "0.577.0",
    "nitro": "npm:nitro-nightly@3.0.1-20261004-132833-c7bec880",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261005.1",
    "@datadog/datadog-ci": "5.24.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/youtube": "0.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "8.3.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5"
    },
    "onlyBuiltDependencies": [
      "@datadog/native-iast-taint-tracking",
      "@datadog/native-metrics",
      "@datadog/pprof",
      "dd-trace",
      "esbuild",
      "lightningcss",
      "workerd"
    ]
  }
}
